{
	"name": "stellar-garden",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint --deny-warnings src/ remotion/",
		"lint:fix": "oxlint --deny-warnings src/ remotion/ --fix",
		"fmt": "oxfmt --write src/",
		"fmt:check": "oxfmt --check src/",
		"cf-typegen": "wrangler types --include-runtime=false",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"studio": "remotion studio remotion/index.ts",
		"render": "remotion render remotion/index.ts StarField out/video.mp4"
	},
	"dependencies": {
		"@remotion/cli": "4.0.509",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"remotion": "4.0.508"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.51.0",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react-swc": "4.3.3",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"wrangler": "4.119.0"
	},
	"pnpm": {
		"overrides": {
			"vite": "8.2.1"
		}
	}
}
