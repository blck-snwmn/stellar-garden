{
	"name": "stellar-garden",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "cf dev",
		"build": "pnpm run cf-typegen && tsc -b && cf build",
		"lint": "oxlint --deny-warnings src/ remotion/",
		"lint:fix": "oxlint --deny-warnings src/ remotion/ --fix",
		"fmt": "oxfmt --write src/",
		"fmt:check": "oxfmt --check src/",
		"cf-typegen": "cf workers types --include-runtime=false",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && cf deploy --prebuilt --mode production",
		"studio": "remotion studio remotion/index.ts",
		"render": "remotion render remotion/index.ts StarField out/video.mp4"
	},
	"dependencies": {
		"@remotion/cli": "4.0.538",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"remotion": "4.0.538"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react-swc": "4.3.3",
		"cf": "1.0.0-beta.21",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"wrangler": "4.143.1"
	}
}
